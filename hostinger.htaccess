Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^upscalerstudio\.esmeraldapaper\.com\.br$ [NC]
    RewriteRule ^$ https://www.esmeraldapaper.com.br/upscalerstudio/ [R=301,L]
    RewriteCond %{HTTP_HOST} ^upscalerstudio\.esmeraldapaper\.com\.br$ [NC]
    RewriteRule ^(.+)$ https://www.esmeraldapaper.com.br/upscalerstudio/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    <Files "index.html">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>
</IfModule>

# web-demuxer runs its WebAssembly module inside a nested worker.
# Allow that public static asset to load from the app's blob worker context.
<IfModule mod_headers.c>
    <Files "web-demuxer.wasm">
        Header always set Access-Control-Allow-Origin "*"
    </Files>
</IfModule>
